import Pell.ShiftedSquareQuadraticInteger
import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.IntegralClosure.IntegralRestrict
import Mathlib.Tactic

/-!
# The canonical square ideal divisor of a shifted-square element

For the integral element

`zeta = (n + sqrt(-a)) / q₂`

with norm `d₀^2 * w`, the manuscript next chooses an integral ideal
`mathfrak d` of norm `d₀` whose square divides `(zeta)`.  This file makes the
choice explicit:

`mathfrak d = (d₀, zeta)`.

The proof is elementary.  The source primitivity gives
`Coprime d₀ (trace zeta)`.  Bezout and the characteristic equation put
`zeta` in `mathfrak d ^ 2`.  The same Bezout identity, together with the
trace and norm identities, proves

`mathfrak d * conjugate(mathfrak d) = (d₀)`.

Taking absolute ideal norms then gives `absNorm mathfrak d = d₀`.  No prime
ideal factorization, class-group choice, Minkowski statement, or analytic
input is used.
-/

namespace PellPaper

noncomputable section

local instance shiftedSquarePrincipalIdealDivisor_numberField (a : ℤ)
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))] :
    NumberField (rationalQuadraticAlgebra (-a)) :=
  rationalQuadraticAlgebra_numberField (-a)

/-- The already-proved integral shifted-square element, now regarded as an
element of the actual ring of integers. -/
def shiftedSquareZetaInteger
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)) :=
  ⟨shiftedSquareZeta a d n, shiftedSquareZeta_isIntegral heq⟩

@[simp] theorem coe_shiftedSquareZetaInteger
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    (shiftedSquareZetaInteger heq : rationalQuadraticAlgebra (-a)) =
      shiftedSquareZeta a d n := by
  rfl

/-- The principal ideal generated by the integral shifted-square element. -/
def shiftedSquareZetaPrincipalIdeal
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) :=
  Ideal.span {shiftedSquareZetaInteger heq}

/-- The explicit ideal `mathfrak d = (d₀, zeta)`. -/
def shiftedSquareIdealDivisor
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) :=
  Ideal.span
    {(shiftedSquareD₀ d :
        NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
      shiftedSquareZetaInteger heq}

private def shiftedSquareQuadraticConjugationAlgEquiv (a : ℤ)
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))] :
    rationalQuadraticAlgebra (-a) ≃ₐ[ℤ] rationalQuadraticAlgebra (-a) :=
  { toRingEquiv := starRingAut
    commutes' := by intro z; simp }

/-- Quadratic conjugation restricted to the actual ring of integers. -/
def shiftedSquareRingOfIntegersConjugation (a : ℤ)
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))] :
    NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)) ≃+*
      NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)) where
  toFun x := ⟨shiftedSquareQuadraticConjugationAlgEquiv a
      (x : rationalQuadraticAlgebra (-a)),
    IsIntegral.map (shiftedSquareQuadraticConjugationAlgEquiv a) x.2⟩
  invFun x := ⟨shiftedSquareQuadraticConjugationAlgEquiv a
      (x : rationalQuadraticAlgebra (-a)),
    IsIntegral.map (shiftedSquareQuadraticConjugationAlgEquiv a) x.2⟩
  left_inv x := by
    apply Subtype.ext
    change star (star (x : rationalQuadraticAlgebra (-a))) = x
    simp
  right_inv x := by
    apply Subtype.ext
    change star (star (x : rationalQuadraticAlgebra (-a))) = x
    simp
  map_mul' x y := by
    apply Subtype.ext
    change star ((x : rationalQuadraticAlgebra (-a)) *
      (y : rationalQuadraticAlgebra (-a))) =
        star (x : rationalQuadraticAlgebra (-a)) *
          star (y : rationalQuadraticAlgebra (-a))
    simp
  map_add' x y := by
    apply Subtype.ext
    exact star_add (x : rationalQuadraticAlgebra (-a))
      (y : rationalQuadraticAlgebra (-a))

/-- The normalized source coordinate divides the original one. -/
theorem shiftedSquareD₀_dvd (d : ℕ) : shiftedSquareD₀ d ∣ d := by
  refine ⟨shiftedSquareQ₂ d, ?_⟩
  simpa only [Nat.mul_comm] using (shiftedSquareQ₂_mul_D₀ d).symm

/-- Source primitivity gives the precise Bezout input used by the ideal
construction in both parity branches. -/
theorem shiftedSquareD₀_coprime_zetaTrace
    {a : ℤ} {d w n : ℕ} (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    (shiftedSquareD₀ d).Coprime (shiftedSquareZetaTrace d n) := by
  have hd₀n : (shiftedSquareD₀ d).Coprime n :=
    Nat.Coprime.of_dvd_left (shiftedSquareD₀_dvd d)
      (shiftedSquareQuadratic_coprime ha heq)
  by_cases hdEven : Even d
  · simpa [shiftedSquareZetaTrace, hdEven] using hd₀n
  · have hdOdd : Odd d := Nat.not_even_iff_odd.mp hdEven
    have hd₀two : (shiftedSquareD₀ d).Coprime 2 := by
      simpa [shiftedSquareD₀, shiftedSquareQ₂, hdEven] using
        hdOdd.coprime_two_right
    simpa [shiftedSquareZetaTrace, hdEven] using hd₀two.mul_right hd₀n

/-- The integer norm of the ring-of-integers element has the same sign and
value as its positive rational norm. -/
theorem shiftedSquareZetaInteger_algebraNorm
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    Algebra.norm ℤ (shiftedSquareZetaInteger heq) =
      (((shiftedSquareD₀ d) ^ 2 * w : ℕ) : ℤ) := by
  apply (IsFractionRing.injective ℤ ℚ)
  rw [← Algebra.intNorm_eq_norm ℤ
    (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))]
  rw [Algebra.algebraMap_intNorm (A := ℤ) (K := ℚ)
    (L := rationalQuadraticAlgebra (-a))
    (B := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))]
  change (Algebra.norm ℚ) (shiftedSquareZeta a d n) = _
  exact shiftedSquareZeta_algebraNorm heq

/-- The principal ideal `(zeta)` has exact absolute norm `d₀^2*w`. -/
theorem shiftedSquareZetaPrincipalIdeal_absNorm
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    Ideal.absNorm (shiftedSquareZetaPrincipalIdeal heq) =
      (shiftedSquareD₀ d) ^ 2 * w := by
  rw [shiftedSquareZetaPrincipalIdeal, Ideal.absNorm_span_singleton,
    shiftedSquareZetaInteger_algebraNorm heq]
  exact Int.natAbs_natCast _

/-- The sum of `zeta` and its conjugate is its displayed integral trace. -/
theorem shiftedSquareZetaInteger_add_conjugate
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    shiftedSquareZetaInteger heq +
        shiftedSquareRingOfIntegersConjugation a
          (shiftedSquareZetaInteger heq) =
      (shiftedSquareZetaTrace d n :
        NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) := by
  apply Subtype.ext
  change shiftedSquareZeta a d n + star (shiftedSquareZeta a d n) =
    (shiftedSquareZetaTrace d n : rationalQuadraticAlgebra (-a))
  calc
    shiftedSquareZeta a d n + star (shiftedSquareZeta a d n) =
        algebraMap ℚ (rationalQuadraticAlgebra (-a))
          (QuadraticAlgebra.trace (shiftedSquareZeta a d n)) :=
      (QuadraticAlgebra.algebraMap_trace_eq_add_star
        (z := shiftedSquareZeta a d n)).symm
    _ = (shiftedSquareZetaTrace d n :
        rationalQuadraticAlgebra (-a)) := by
      rw [shiftedSquareZeta_trace]
      norm_num

/-- The product of `zeta` and its conjugate is the displayed natural norm. -/
theorem shiftedSquareZetaInteger_mul_conjugate
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    shiftedSquareZetaInteger heq *
        shiftedSquareRingOfIntegersConjugation a
          (shiftedSquareZetaInteger heq) =
      ((shiftedSquareD₀ d) ^ 2 * w :
        NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) := by
  apply Subtype.ext
  change shiftedSquareZeta a d n * star (shiftedSquareZeta a d n) =
    ((shiftedSquareD₀ d) ^ 2 * w : rationalQuadraticAlgebra (-a))
  calc
    shiftedSquareZeta a d n * star (shiftedSquareZeta a d n) =
        algebraMap ℚ (rationalQuadraticAlgebra (-a))
          (QuadraticAlgebra.norm (shiftedSquareZeta a d n)) :=
      (QuadraticAlgebra.algebraMap_norm_eq_mul_star _).symm
    _ = ((shiftedSquareD₀ d) ^ 2 * w :
        rationalQuadraticAlgebra (-a)) := by
      rw [shiftedSquareZeta_quadraticNorm heq]
      norm_num

/-- Quadratic conjugation preserves absolute ideal norm. -/
theorem shiftedSquare_absNorm_map_conjugation
    (a : ℤ) [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (I : Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))) :
    Ideal.absNorm
        (I.map (shiftedSquareRingOfIntegersConjugation a)) =
      Ideal.absNorm I := by
  simp only [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  exact Nat.card_congr
    (Ideal.quotientEquiv I
      (I.map (shiftedSquareRingOfIntegersConjugation a))
      (shiftedSquareRingOfIntegersConjugation a) rfl).symm.toEquiv

/-- The conjugate product of the explicit ideal divisor is exactly `(d₀)`. -/
theorem shiftedSquareIdealDivisor_mul_conjugate
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    shiftedSquareIdealDivisor heq *
        (shiftedSquareIdealDivisor heq).map
          (shiftedSquareRingOfIntegersConjugation a) =
      Ideal.span
        {(shiftedSquareD₀ d :
          NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))} := by
  let R := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))
  let d₀ : R := shiftedSquareD₀ d
  let T : R := shiftedSquareZetaTrace d n
  let z : R := shiftedSquareZetaInteger heq
  let z' : R := shiftedSquareRingOfIntegersConjugation a z
  have htrace : z + z' = T := by
    exact shiftedSquareZetaInteger_add_conjugate heq
  have hnorm : z * z' = (d₀ * d₀) * (w : R) := by
    simpa only [d₀, z, z', Nat.cast_mul, Nat.cast_pow, pow_two] using
      shiftedSquareZetaInteger_mul_conjugate heq
  have hcop : IsCoprime d₀ T := by
    exact (shiftedSquareD₀_coprime_zetaTrace ha heq).cast
  obtain ⟨x, y, hxy⟩ := hcop
  have hmap :
      (shiftedSquareIdealDivisor heq).map
          (shiftedSquareRingOfIntegersConjugation a) =
        Ideal.span {d₀, z'} := by
    rw [shiftedSquareIdealDivisor, Ideal.map_span,
      Set.image_insert_eq, Set.image_singleton]
    simp [d₀, z', z]
    rfl
  rw [hmap]
  change Ideal.span {d₀, z} * Ideal.span {d₀, z'} = Ideal.span {d₀}
  rw [Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro u hu
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu
    rcases hu with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr (dvd_mul_right d₀ d₀)
    · exact Ideal.mem_span_singleton.mpr (dvd_mul_right d₀ z')
    · exact Ideal.mem_span_singleton.mpr (dvd_mul_left d₀ z)
    · rw [hnorm]
      exact Ideal.mem_span_singleton.mpr
        (dvd_mul_of_dvd_left (dvd_mul_right d₀ d₀) (w : R))
  · apply (Ideal.span_singleton_le_iff_mem _).mpr
    let J : Ideal R := Ideal.span {d₀ * d₀, d₀ * z', z * d₀, z * z'}
    have hd₀d₀ : d₀ * d₀ ∈ J := Ideal.subset_span (by simp)
    have hd₀z' : d₀ * z' ∈ J := Ideal.subset_span (by simp)
    have hzd₀ : z * d₀ ∈ J := Ideal.subset_span (by simp)
    have hd₀T : d₀ * T ∈ J := by
      have hadd : d₀ * z + d₀ * z' ∈ J :=
        J.add_mem (by simpa [mul_comm] using hzd₀) hd₀z'
      rwa [← mul_add, htrace] at hadd
    have hsum := J.add_mem
      (J.mul_mem_left x hd₀d₀) (J.mul_mem_left y hd₀T)
    have heq : x * (d₀ * d₀) + y * (d₀ * T) = d₀ := by
      linear_combination d₀ * hxy
    change d₀ ∈ J
    rwa [heq] at hsum

/-- The explicit ideal divisor has absolute norm exactly `d₀`. -/
theorem shiftedSquareIdealDivisor_absNorm
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    Ideal.absNorm (shiftedSquareIdealDivisor heq) = shiftedSquareD₀ d := by
  have hprod := congrArg Ideal.absNorm
    (shiftedSquareIdealDivisor_mul_conjugate ha heq)
  rw [map_mul, shiftedSquare_absNorm_map_conjugation] at hprod
  have hrank : Module.finrank ℤ
      (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) = 2 := by
    rw [NumberField.RingOfIntegers.rank]
    exact QuadraticAlgebra.finrank_eq_two ((-a : ℤ) : ℚ) 0
  rw [Ideal.absNorm_span_natCast, hrank] at hprod
  exact Nat.pow_left_injective (by decide : 2 ≠ 0)
    (by simpa only [pow_two] using hprod)

/-- For positive `d`, the constructed ideal is nonzero.  This is the exact
input needed to pass it to `FractionalIdeal.mk0` in the subsequent Minkowski
stage. -/
theorem shiftedSquareIdealDivisor_ne_bot
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    shiftedSquareIdealDivisor heq ≠ ⊥ := by
  intro hbot
  have hnorm := shiftedSquareIdealDivisor_absNorm ha heq
  rw [hbot, Ideal.absNorm_bot] at hnorm
  exact (shiftedSquareD₀_pos hd).ne' hnorm.symm

/-- The characteristic equation and Bezout identity give the literal square
ideal divisibility `mathfrak d^2 | (zeta)`. -/
theorem shiftedSquareIdealDivisor_sq_dvd_principal
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    (shiftedSquareIdealDivisor heq) ^ 2 ∣
      shiftedSquareZetaPrincipalIdeal heq := by
  let R := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))
  let d₀ : R := shiftedSquareD₀ d
  let T : R := shiftedSquareZetaTrace d n
  let z : R := shiftedSquareZetaInteger heq
  let z' : R := shiftedSquareRingOfIntegersConjugation a z
  let I : Ideal R := shiftedSquareIdealDivisor heq
  have htrace : z + z' = T := by
    exact shiftedSquareZetaInteger_add_conjugate heq
  have hnorm : z * z' = (d₀ * d₀) * (w : R) := by
    simpa only [d₀, z, z', Nat.cast_mul, Nat.cast_pow, pow_two] using
      shiftedSquareZetaInteger_mul_conjugate heq
  have hchar : z * z - T * z + (d₀ * d₀) * (w : R) = 0 := by
    rw [← htrace, ← hnorm]
    ring
  have hcop : IsCoprime d₀ T := by
    exact (shiftedSquareD₀_coprime_zetaTrace ha heq).cast
  obtain ⟨x, y, hxy⟩ := hcop
  have hd₀mem : d₀ ∈ I := by
    exact Ideal.subset_span (by simp [d₀])
  have hzmem : z ∈ I := by
    exact Ideal.subset_span (by simp [z])
  have hd₀sq : d₀ * d₀ ∈ I ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hd₀mem hd₀mem
  have hzsq : z * z ∈ I ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hzmem hzmem
  have hd₀z : d₀ * z ∈ I ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hd₀mem hzmem
  have hconst : (d₀ * d₀) * (w : R) ∈ I ^ 2 :=
    (I ^ 2).mul_mem_right (w : R) hd₀sq
  have hTz : T * z ∈ I ^ 2 := by
    have heq : T * z = z * z + (d₀ * d₀) * (w : R) := by
      linear_combination -hchar
    rw [heq]
    exact (I ^ 2).add_mem hzsq hconst
  have hsum := (I ^ 2).add_mem
    ((I ^ 2).mul_mem_left x hd₀z) ((I ^ 2).mul_mem_left y hTz)
  have hz : x * (d₀ * z) + y * (T * z) = z := by
    linear_combination z * hxy
  rw [Ideal.dvd_iff_le, shiftedSquareZetaPrincipalIdeal,
    Ideal.span_singleton_le_iff_mem]
  change z ∈ I ^ 2
  rwa [hz] at hsum

/-- Any ideal of norm `d₀` whose square divides `(zeta)` is the explicit
ideal `(d₀, zeta)`.  Positivity of `d` is used only to cancel the nonzero
ideal norm `d₀`. -/
theorem shiftedSquareIdealDivisor_unique
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    (J : Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))))
    (hJnorm : Ideal.absNorm J = shiftedSquareD₀ d)
    (hJsq : J ^ 2 ∣ shiftedSquareZetaPrincipalIdeal heq) :
    J = shiftedSquareIdealDivisor heq := by
  let R := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))
  let z : R := shiftedSquareZetaInteger heq
  let I : Ideal R := shiftedSquareIdealDivisor heq
  have hprincipal_le : shiftedSquareZetaPrincipalIdeal heq ≤ J ^ 2 :=
    Ideal.dvd_iff_le.mp hJsq
  have hzJtwo : z ∈ J ^ 2 := by
    apply hprincipal_le
    exact Ideal.mem_span_singleton_self z
  have hzJ : z ∈ J := by
    rw [pow_two] at hzJtwo
    exact Ideal.mul_le_left hzJtwo
  have hd₀J :
      (shiftedSquareD₀ d : R) ∈ J := by
    simpa only [hJnorm] using Ideal.absNorm_mem J
  have hIJ : I ≤ J := by
    apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact hd₀J
    · exact hzJ
  have hJdvdI : J ∣ I := Ideal.dvd_iff_le.mpr hIJ
  obtain ⟨C, hIC⟩ := hJdvdI
  have hnorm := congrArg Ideal.absNorm hIC
  rw [map_mul, shiftedSquareIdealDivisor_absNorm ha heq, hJnorm] at hnorm
  have hd₀pos : 0 < shiftedSquareD₀ d := shiftedSquareD₀_pos hd
  have hCnorm : Ideal.absNorm C = 1 := by
    apply Nat.eq_of_mul_eq_mul_left hd₀pos
    simpa only [mul_one] using hnorm.symm
  have hCtop : C = ⊤ := Ideal.absNorm_eq_one_iff.mp hCnorm
  have hIJ' : I = J := by
    simpa only [hCtop, Ideal.mul_top] using hIC
  exact hIJ'.symm

/-- Removing the constructed square divisor leaves an integral ideal of
absolute norm exactly `w`. -/
theorem exists_shiftedSquareResidualIdeal
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    ∃ J : Ideal
        (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
      shiftedSquareZetaPrincipalIdeal heq =
          shiftedSquareIdealDivisor heq ^ 2 * J ∧
        Ideal.absNorm J = w := by
  obtain ⟨J, hJ⟩ := shiftedSquareIdealDivisor_sq_dvd_principal ha heq
  refine ⟨J, hJ, ?_⟩
  have hnorm := congrArg Ideal.absNorm hJ
  rw [map_mul, map_pow, shiftedSquareZetaPrincipalIdeal_absNorm,
    shiftedSquareIdealDivisor_absNorm ha heq] at hnorm
  apply Nat.eq_of_mul_eq_mul_left (pow_pos (shiftedSquareD₀_pos hd) 2)
  simpa only [mul_assoc] using hnorm.symm

/-- Exact project-facing existence package.  The no-rational-root and number
field instances are discharged from the squarefree shift and `a ≠ -1`; the
caller supplies no ideal-theoretic premise. -/
theorem exists_shiftedSquareIdealDivisor
    {a : ℤ} {d w n : ℕ}
    (ha : Squarefree a) (haNegOne : a ≠ -1)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
      ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
    ∃ mathfrakD :
        Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
      Ideal.absNorm mathfrakD = shiftedSquareD₀ d ∧
      mathfrakD ^ 2 ∣ shiftedSquareZetaPrincipalIdeal heq := by
  let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
    ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
  exact ⟨shiftedSquareIdealDivisor heq,
    shiftedSquareIdealDivisor_absNorm ha heq,
    shiftedSquareIdealDivisor_sq_dvd_principal ha heq⟩

/-- Exact manuscript-strength existence and uniqueness package for positive
`d`. -/
theorem existsUnique_shiftedSquareIdealDivisor
    {a : ℤ} {d w n : ℕ}
    (ha : Squarefree a) (haNegOne : a ≠ -1) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
      ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
    ∃! mathfrakD :
        Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
      Ideal.absNorm mathfrakD = shiftedSquareD₀ d ∧
      mathfrakD ^ 2 ∣ shiftedSquareZetaPrincipalIdeal heq := by
  let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
    ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
  refine ⟨shiftedSquareIdealDivisor heq,
    ⟨shiftedSquareIdealDivisor_absNorm ha heq,
      shiftedSquareIdealDivisor_sq_dvd_principal ha heq⟩, ?_⟩
  intro J hJ
  exact shiftedSquareIdealDivisor_unique ha hd heq J hJ.1 hJ.2

/-- Strongest project-facing package for the ideal-divisor stage: the unique
ideal divisor has the manuscript norm and divisibility properties, and its
square can be removed from `(zeta)` leaving an integral ideal of norm `w`. -/
theorem existsUnique_shiftedSquareIdealDivisorWithResidual
    {a : ℤ} {d w n : ℕ}
    (ha : Squarefree a) (haNegOne : a ≠ -1) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
      ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
    ∃! mathfrakD :
        Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
      Ideal.absNorm mathfrakD = shiftedSquareD₀ d ∧
      mathfrakD ^ 2 ∣ shiftedSquareZetaPrincipalIdeal heq ∧
      ∃ residual :
          Ideal (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))),
        shiftedSquareZetaPrincipalIdeal heq = mathfrakD ^ 2 * residual ∧
        Ideal.absNorm residual = w := by
  let _ : Fact (rationalQuadraticAlgebraNoRationalRoot (-a)) :=
    ⟨shiftedSquare_radicand_noRationalRoot ha haNegOne⟩
  refine ⟨shiftedSquareIdealDivisor heq,
    ⟨shiftedSquareIdealDivisor_absNorm ha heq,
      shiftedSquareIdealDivisor_sq_dvd_principal ha heq,
      exists_shiftedSquareResidualIdeal ha hd heq⟩, ?_⟩
  intro J hJ
  exact shiftedSquareIdealDivisor_unique ha hd heq J hJ.1 hJ.2.1

end

