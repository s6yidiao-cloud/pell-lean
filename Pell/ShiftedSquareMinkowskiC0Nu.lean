import Pell.ShiftedSquareMinkowskiElement
import Mathlib.Tactic

/-!
# The integral C₀–nu factorization attached to the Minkowski element

For a nonzero `mu` in the explicit shifted-square ideal divisor, this file
defines the finite index

`C₀ = absNorm (mu) / d₀`.

It proves that `C₀` is positive, realizes the quotient by an integral ideal
`Q`, obtains `C₀ * I ≤ (mu)`, and uses `(zeta) ≤ I^2` to construct an
integral `nu` satisfying

`mu^2 * nu = C₀^2 * zeta`.

The two exact norm identities and the discriminant-scale bound on `C₀` are
then derived inside Lean.
-/

namespace PellPaper

noncomputable section

local instance shiftedSquareMinkowskiC₀Nu_numberField (a : ℤ)
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))] :
    NumberField (rationalQuadraticAlgebra (-a)) :=
  rationalQuadraticAlgebra_numberField (-a)

/-- The finite index of the principal ideal generated by `mu` inside the
explicit ideal divisor, expressed as a natural-number norm quotient. -/
def shiftedSquareC₀
    {a : ℤ} {d : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) : ℕ :=
  Ideal.absNorm (Ideal.span {mu}) / shiftedSquareD₀ d

theorem shiftedSquareD₀_dvd_muPrincipalAbsNorm
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) :
    shiftedSquareD₀ d ∣ Ideal.absNorm (Ideal.span {mu}) := by
  rw [← shiftedSquareIdealDivisor_absNorm ha heq]
  exact Ideal.absNorm_dvd_absNorm_of_le
    ((Ideal.span_singleton_le_iff_mem _).2 hmu)

theorem shiftedSquareC₀_mul_D₀
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) :
    shiftedSquareC₀ (d := d) mu * shiftedSquareD₀ d =
      Ideal.absNorm (Ideal.span {mu}) := by
  exact Nat.div_mul_cancel
    (shiftedSquareD₀_dvd_muPrincipalAbsNorm ha heq hmu)

theorem shiftedSquare_mu_rationalNorm_abs
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) :
    |Algebra.norm ℚ (mu : rationalQuadraticAlgebra (-a))| =
      ((shiftedSquareD₀ d * shiftedSquareC₀ (d := d) mu : ℕ) : ℚ) := by
  have hnormCast :
      ((Algebra.norm ℤ mu : ℤ) : ℚ) =
        Algebra.norm ℚ (mu : rationalQuadraticAlgebra (-a)) := by
    rw [← Algebra.intNorm_eq_norm ℤ
      (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))]
    exact Algebra.algebraMap_intNorm
      (A := ℤ) (K := ℚ) (L := rationalQuadraticAlgebra (-a))
      (B := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) mu
  calc
    |Algebra.norm ℚ (mu : rationalQuadraticAlgebra (-a))| =
        |((Algebra.norm ℤ mu : ℤ) : ℚ)| := by rw [hnormCast]
    _ = ((Algebra.norm ℤ mu).natAbs : ℚ) := by simp
    _ = (Ideal.absNorm (Ideal.span {mu}) : ℚ) := by
      rw [Ideal.absNorm_span_singleton]
    _ = ((shiftedSquareD₀ d *
          shiftedSquareC₀ (d := d) mu : ℕ) : ℚ) := by
      rw [← shiftedSquareC₀_mul_D₀ ha heq hmu, mul_comm]

theorem shiftedSquareC₀_pos
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) (hmu0 : mu ≠ 0) :
    0 < shiftedSquareC₀ (d := d) mu := by
  have hMne : Ideal.span {mu} ≠
      (⊥ : Ideal (NumberField.RingOfIntegers
        (rationalQuadraticAlgebra (-a)))) := by
    intro hM
    exact hmu0 (Ideal.span_singleton_eq_bot.mp hM)
  have hnormPos : 0 < Ideal.absNorm (Ideal.span {mu}) :=
    Nat.pos_of_ne_zero (mt Ideal.absNorm_eq_zero_iff.mp hMne)
  exact Nat.div_pos
    (Nat.le_of_dvd hnormPos
      (shiftedSquareD₀_dvd_muPrincipalAbsNorm ha heq hmu))
    (shiftedSquareD₀_pos hd)

theorem shiftedSquareC₀_le_sqrt_discr_of_norm_le
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq)
    (hbound :
      ((|Algebra.norm ℚ
          (mu : rationalQuadraticAlgebra (-a))| : ℚ) : ℝ) ≤
        (shiftedSquareD₀ d : ℝ) *
          Real.sqrt |NumberField.discr (rationalQuadraticAlgebra (-a))|) :
    (shiftedSquareC₀ (d := d) mu : ℝ) ≤
      Real.sqrt |NumberField.discr (rationalQuadraticAlgebra (-a))| := by
  have hnormQ := shiftedSquare_mu_rationalNorm_abs ha heq hmu
  have hnormR := congrArg (fun q : ℚ => (q : ℝ)) hnormQ
  have hd₀R : (0 : ℝ) < shiftedSquareD₀ d := by
    exact_mod_cast shiftedSquareD₀_pos hd
  apply (mul_le_mul_iff_of_pos_left hd₀R).mp
  calc
    (shiftedSquareD₀ d : ℝ) *
          (shiftedSquareC₀ (d := d) mu : ℝ) =
        ((((shiftedSquareD₀ d *
          shiftedSquareC₀ (d := d) mu : ℕ) : ℚ)) : ℝ) := by
      norm_num
    _ = ((|Algebra.norm ℚ
          (mu : rationalQuadraticAlgebra (-a))| : ℚ) : ℝ) := by
      rw [hnormR]
    _ ≤ (shiftedSquareD₀ d : ℝ) *
          Real.sqrt |NumberField.discr (rationalQuadraticAlgebra (-a))| := hbound

theorem exists_shiftedSquareC₀_quotientIdeal
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) :
    ∃ Q : Ideal (NumberField.RingOfIntegers
        (rationalQuadraticAlgebra (-a))),
      Ideal.span {mu} = shiftedSquareIdealDivisor heq * Q ∧
      Ideal.absNorm Q = shiftedSquareC₀ (d := d) mu ∧
      Ideal.span
          {(shiftedSquareC₀ (d := d) mu :
            NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))} *
          shiftedSquareIdealDivisor heq ≤ Ideal.span {mu} := by
  have hle : Ideal.span {mu} ≤ shiftedSquareIdealDivisor heq :=
    (Ideal.span_singleton_le_iff_mem _).2 hmu
  obtain ⟨Q, hQ⟩ := (Ideal.dvd_iff_le.2 hle)
  have hQnorm :
      Ideal.absNorm Q = shiftedSquareC₀ (d := d) mu := by
    have hnorm := congrArg Ideal.absNorm hQ
    rw [map_mul, shiftedSquareIdealDivisor_absNorm ha heq] at hnorm
    simp only [shiftedSquareC₀, hnorm]
    exact (Nat.mul_div_cancel_left (Ideal.absNorm Q)
      (shiftedSquareD₀_pos hd)).symm
  refine ⟨Q, hQ, hQnorm, ?_⟩
  · have hCmem :
        (shiftedSquareC₀ (d := d) mu :
            NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) ∈ Q := by
      rw [← hQnorm]
      exact Ideal.absNorm_mem Q
    calc
      Ideal.span
            {(shiftedSquareC₀ (d := d) mu :
              NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))} *
          shiftedSquareIdealDivisor heq ≤ Q * shiftedSquareIdealDivisor heq := by
        exact mul_le_mul ((Ideal.span_singleton_le_iff_mem Q).2 hCmem)
          le_rfl bot_le bot_le
      _ = shiftedSquareIdealDivisor heq * Q := mul_comm _ _
      _ = Ideal.span {mu} := hQ.symm

theorem exists_shiftedSquareNu
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) :
    ∃ nu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)),
      mu ^ 2 * nu =
        (shiftedSquareC₀ (d := d) mu :
          NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) ^ 2 *
          shiftedSquareZetaInteger heq := by
  let O := NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))
  let I : Ideal O := shiftedSquareIdealDivisor heq
  let M : Ideal O := Ideal.span {mu}
  let C : O := shiftedSquareC₀ (d := d) mu
  let Z : Ideal O := shiftedSquareZetaPrincipalIdeal heq
  obtain ⟨Q, hQ, hQnorm, hCI⟩ :=
    exists_shiftedSquareC₀_quotientIdeal ha hd heq hmu
  have hZ : Z ≤ I ^ 2 := by
    exact Ideal.dvd_iff_le.mp
      (shiftedSquareIdealDivisor_sq_dvd_principal ha heq)
  have hCIsq :
      (Ideal.span {C} * I) * (Ideal.span {C} * I) ≤ M * M := by
    exact mul_le_mul hCI hCI bot_le bot_le
  have htarget : Ideal.span {C ^ 2 * shiftedSquareZetaInteger heq} ≤
      Ideal.span {mu ^ 2} := by
    calc
      Ideal.span {C ^ 2 * shiftedSquareZetaInteger heq} =
          Ideal.span {C ^ 2} * Z := by
        simp only [Z, shiftedSquareZetaPrincipalIdeal,
          Ideal.span_singleton_mul_span_singleton]
      _ ≤ Ideal.span {C ^ 2} * I ^ 2 := by
        exact mul_le_mul le_rfl hZ bot_le bot_le
      _ = (Ideal.span {C} * I) * (Ideal.span {C} * I) := by
        simp only [pow_two]
        rw [← Ideal.span_singleton_mul_span_singleton C C]
        ac_rfl
      _ ≤ M * M := hCIsq
      _ = Ideal.span {mu ^ 2} := by
        dsimp only [M]
        rw [pow_two, Ideal.span_singleton_mul_span_singleton]
  have hmem : C ^ 2 * shiftedSquareZetaInteger heq ∈
      Ideal.span {mu ^ 2} :=
    (Ideal.span_singleton_le_iff_mem _).mp htarget
  obtain ⟨nu, hnu⟩ := Ideal.mem_span_singleton.mp hmem
  refine ⟨nu, ?_⟩
  simpa only [C, O, mul_comm] using hnu.symm

theorem shiftedSquareNu_algebraNorm
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a)
    {mu nu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))}
    (hmu : mu ∈ shiftedSquareIdealDivisor heq) (hmu0 : mu ≠ 0)
    (hnu : mu ^ 2 * nu =
      (shiftedSquareC₀ (d := d) mu :
        NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) ^ 2 *
        shiftedSquareZetaInteger heq) :
    Algebra.norm ℤ nu =
      ((w * shiftedSquareC₀ (d := d) mu ^ 2 : ℕ) : ℤ) := by
  let C := shiftedSquareC₀ (d := d) mu
  have hmuNat : (Algebra.norm ℤ mu).natAbs = shiftedSquareD₀ d * C := by
    rw [← Ideal.absNorm_span_singleton]
    simpa only [C, mul_comm] using
      (shiftedSquareC₀_mul_D₀ ha heq hmu).symm
  have hmuSq :
      (Algebra.norm ℤ mu) ^ 2 =
        (((shiftedSquareD₀ d * C : ℕ) : ℤ)) ^ 2 := by
    rw [← Int.natAbs_sq, hmuNat]
  have hrank : Module.finrank ℤ
      (NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a))) = 2 := by
    rw [NumberField.RingOfIntegers.rank]
    exact QuadraticAlgebra.finrank_eq_two ((-a : ℤ) : ℚ) 0
  have hN := congrArg (Algebra.norm ℤ) hnu
  simp only [map_mul, map_pow, Algebra.norm_natCast, hrank,
    shiftedSquareZetaInteger_algebraNorm heq] at hN
  rw [hmuSq] at hN
  have hCpos : 0 < C :=
    shiftedSquareC₀_pos ha hd heq hmu hmu0
  have hproductPos : 0 < shiftedSquareD₀ d * C :=
    Nat.mul_pos (shiftedSquareD₀_pos hd) hCpos
  have hfactorPos :
      (0 : ℤ) < (((shiftedSquareD₀ d * C : ℕ) : ℤ)) ^ 2 := by
    exact_mod_cast pow_pos hproductPos 2
  apply mul_left_cancel₀ hfactorPos.ne'
  calc
    (((shiftedSquareD₀ d * C : ℕ) : ℤ)) ^ 2 *
          Algebra.norm ℤ nu =
        (((shiftedSquareD₀ d * C : ℕ) : ℤ)) ^ 2 *
          ((w * C ^ 2 : ℕ) : ℤ) := by
      calc
        _ = ((C : ℤ) ^ 2) ^ 2 *
              (((shiftedSquareD₀ d) ^ 2 * w : ℕ) : ℤ) := hN
        _ = _ := by norm_num; ring
    _ = _ := rfl

theorem exists_shiftedSquareMinkowskiC₀Nu_package
    {a : ℤ} {d w n : ℕ}
    [Fact (rationalQuadraticAlgebraNoRationalRoot (-a))]
    (ha : Squarefree a) (hd : 0 < d)
    (heq : (d : ℤ) ^ 2 * (w : ℤ) = (n : ℤ) ^ 2 + a) :
    ∃ (mu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))
        (C₀ : ℕ)
        (nu : NumberField.RingOfIntegers (rationalQuadraticAlgebra (-a)))
        (Q : Ideal (NumberField.RingOfIntegers
          (rationalQuadraticAlgebra (-a)))),
      mu ∈ shiftedSquareIdealDivisor heq ∧
      mu ≠ 0 ∧
      0 < C₀ ∧
      |Algebra.norm ℚ (mu : rationalQuadraticAlgebra (-a))| =
        ((shiftedSquareD₀ d * C₀ : ℕ) : ℚ) ∧
      mu ^ 2 * nu =
        (C₀ : NumberField.RingOfIntegers
          (rationalQuadraticAlgebra (-a))) ^ 2 *
          shiftedSquareZetaInteger heq ∧
      Algebra.norm ℤ nu = ((w * C₀ ^ 2 : ℕ) : ℤ) ∧
      (C₀ : ℝ) ≤
        Real.sqrt |NumberField.discr (rationalQuadraticAlgebra (-a))| ∧
      Ideal.span {mu} = shiftedSquareIdealDivisor heq * Q ∧
      Ideal.absNorm Q = C₀ ∧
      Ideal.span
          {(C₀ : NumberField.RingOfIntegers
            (rationalQuadraticAlgebra (-a)))} *
          shiftedSquareIdealDivisor heq ≤ Ideal.span {mu} := by
  obtain ⟨mu, hmu, hmu0, hmubound⟩ :=
    exists_shiftedSquareIdealDivisor_minkowskiElement_norm_le ha hd heq
  let C₀ := shiftedSquareC₀ (d := d) mu
  obtain ⟨Q, hQ, hQnorm, hCI⟩ :=
    exists_shiftedSquareC₀_quotientIdeal ha hd heq hmu
  obtain ⟨nu, hnu⟩ := exists_shiftedSquareNu ha hd heq hmu
  refine ⟨mu, C₀, nu, Q, hmu, hmu0,
    shiftedSquareC₀_pos ha hd heq hmu hmu0, ?_, hnu, ?_, ?_,
    hQ, hQnorm, hCI⟩
  · exact shiftedSquare_mu_rationalNorm_abs ha heq hmu
  · exact shiftedSquareNu_algebraNorm ha hd heq hmu hmu0 hnu
  · exact shiftedSquareC₀_le_sqrt_discr_of_norm_le
      ha hd heq hmu hmubound

end

end PellPaper
