import Pell.GeneralBidegreeParallelPolynomial
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# A finite-support rank bound from the parallel-line ideal

The rank filtration in `L:sheared` of `main.tex` is the evaluation rank of
finite families of coefficient monomials on `Γ_{A,B}`.  The polynomial

`P = ∏_{a=0}^A (N₁ - 2 N₂ - a)`

and all of its multiples lie in that evaluation kernel.  This file turns
that fact into an exact finite-dimensional inequality.  If a finite
monomial support `U` contains the products `P * N^m` for every `m` in a
second finite support `T`, then the evaluation rank on `U` is at most
`|U| - |T|`.

The remaining weighted-filtration work is the elementary but still-open
support-containment statement for the manuscript's particular weight balls.
No determinant estimate is used here.
-/

namespace PellPaper

open scoped BigOperators

/-- A bivariate exponent vector for the coefficient monomials in the
Taylor expansion. -/
abbrev generalBidegreeCoefficientMonomialIndex := Fin 2 →₀ ℕ

/-- Multiplication by the nonzero parallel-line polynomial, regarded as a
rational linear map on bivariate polynomials. -/
noncomputable def mulByGeneralBidegreeParallelLinePolynomial (A : ℕ) :
    MvPolynomial (Fin 2) ℚ →ₗ[ℚ] MvPolynomial (Fin 2) ℚ where
  toFun Q := generalBidegreeParallelLinePolynomial A * Q
  map_add' Q R := by
    simp only [mul_add]
  map_smul' c Q := by
    simp only [Algebra.smul_def, RingHom.id_apply]
    ac_rfl

/-- Since the parallel-line polynomial is nonzero, multiplication by it is
injective. -/
theorem mulByGeneralBidegreeParallelLinePolynomial_injective (A : ℕ) :
    Function.Injective (mulByGeneralBidegreeParallelLinePolynomial A) := by
  intro Q R hQR
  change generalBidegreeParallelLinePolynomial A * Q =
    generalBidegreeParallelLinePolynomial A * R at hQR
  have hzero : generalBidegreeParallelLinePolynomial A * (Q - R) = 0 := by
    rw [mul_sub, hQR, sub_self]
  have hQRzero : Q - R = 0 :=
    (mul_eq_zero.mp hzero).resolve_left
      (generalBidegreeParallelLinePolynomial_ne_zero A)
  exact sub_eq_zero.mp hQRzero

/-- The kernel of multiplication by the parallel-line polynomial is zero. -/
theorem ker_mulByGeneralBidegreeParallelLinePolynomial (A : ℕ) :
    (mulByGeneralBidegreeParallelLinePolynomial A).ker = ⊥ :=
  LinearMap.ker_eq_bot_of_injective
    (mulByGeneralBidegreeParallelLinePolynomial_injective A)

/-- The polynomial multiples `P * N^m` are linearly independent as `m`
ranges over all bivariate monomial exponents. -/
theorem linearIndependent_generalBidegreeParallelLineMonomialMultiples
    (A : ℕ) :
    LinearIndependent ℚ (fun m : generalBidegreeCoefficientMonomialIndex =>
      generalBidegreeParallelLinePolynomial A * MvPolynomial.monomial m (1 : ℚ)) := by
  have hmonomial : LinearIndependent ℚ
      (fun m : generalBidegreeCoefficientMonomialIndex =>
        MvPolynomial.monomial m (1 : ℚ)) := by
    simpa only [MvPolynomial.coe_basisMonomials] using
      (MvPolynomial.basisMonomials (Fin 2) ℚ).linearIndependent
  have h := hmonomial.map'
    (mulByGeneralBidegreeParallelLinePolynomial A)
    (ker_mulByGeneralBidegreeParallelLinePolynomial A)
  simpa [Function.comp_def, mulByGeneralBidegreeParallelLinePolynomial] using h

/-- The restriction of the independent multiples to a finite exponent
support. -/
noncomputable def generalBidegreeParallelLineMonomialMultiples
    (A : ℕ) (T : Finset generalBidegreeCoefficientMonomialIndex) :
    T → MvPolynomial (Fin 2) ℚ :=
  fun m => generalBidegreeParallelLinePolynomial A *
    MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ)

theorem linearIndependent_generalBidegreeParallelLineMonomialMultiples_on
    (A : ℕ) (T : Finset generalBidegreeCoefficientMonomialIndex) :
    LinearIndependent ℚ
      (generalBidegreeParallelLineMonomialMultiples A T) := by
  unfold generalBidegreeParallelLineMonomialMultiples
  exact (linearIndependent_generalBidegreeParallelLineMonomialMultiples A).comp
    (fun m : T => (m : generalBidegreeCoefficientMonomialIndex))
    Subtype.val_injective

/-- A finite set of coefficient monomials indexed by a finite exponent
support. -/
noncomputable def generalBidegreeCoefficientMonomialFinset
    (U : Finset generalBidegreeCoefficientMonomialIndex) :
    Finset (MvPolynomial (Fin 2) ℚ) :=
  U.image (fun m => MvPolynomial.monomial m (1 : ℚ))

/-- The finite-dimensional polynomial space generated by a finite monomial
support. -/
noncomputable def generalBidegreeCoefficientMonomialSpan
    (U : Finset generalBidegreeCoefficientMonomialIndex) :
    Submodule ℚ (MvPolynomial (Fin 2) ℚ) :=
  Submodule.span ℚ (generalBidegreeCoefficientMonomialFinset U : Set _)

/-- The rank of coefficient evaluation on a finite monomial support.  The
domain is the span of those monomials, so this is exactly the rank of their
finite family of grid-evaluation vectors. -/
noncomputable def generalBidegreeCoefficientEvaluationRank (A B : ℕ)
    (U : Finset generalBidegreeCoefficientMonomialIndex) : ℕ :=
  Module.finrank ℚ (LinearMap.range
    ((generalBidegreeGridPolynomialEvaluationLinearMap A B).domRestrict
      (generalBidegreeCoefficientMonomialSpan U)))

/-- Any finite-dimensional polynomial subspace containing `|T|` distinct
parallel-line multiples has evaluation rank at least `|T|` below its own
dimension. -/
theorem finrank_range_generalBidegreeGridPolynomialEvaluation_domRestrict_le
    (A B : ℕ) (W : Submodule ℚ (MvPolynomial (Fin 2) ℚ))
    [FiniteDimensional ℚ W]
    (T : Finset generalBidegreeCoefficientMonomialIndex)
    (hW : ∀ m : T,
      generalBidegreeParallelLinePolynomial A *
        MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ) ∈ W) :
    Module.finrank ℚ (LinearMap.range
      ((generalBidegreeGridPolynomialEvaluationLinearMap A B).domRestrict W)) ≤
        Module.finrank ℚ W - T.card := by
  classical
  let F := (generalBidegreeGridPolynomialEvaluationLinearMap A B).domRestrict W
  let g : T → W := fun m => ⟨
    generalBidegreeParallelLinePolynomial A *
      MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ),
    hW m⟩
  have hg_linearIndependent : LinearIndependent ℚ g := by
    apply LinearIndependent.of_comp W.subtype
    change LinearIndependent ℚ (fun m : T =>
      generalBidegreeParallelLinePolynomial A *
        MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ))
    exact linearIndependent_generalBidegreeParallelLineMonomialMultiples_on A T
  have hg_ker : ∀ m : T, g m ∈ F.ker := by
    intro m
    rw [LinearMap.mem_ker]
    change generalBidegreeGridPolynomialEvaluationLinearMap A B
      (generalBidegreeParallelLinePolynomial A *
        MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ)) = 0
    exact mul_generalBidegreeParallelLinePolynomial_mem_gridEvaluation_ker A B _
  let gker : T → F.ker := fun m => ⟨g m, hg_ker m⟩
  have hgker_linearIndependent : LinearIndependent ℚ gker := by
    apply LinearIndependent.of_comp F.ker.subtype
    change LinearIndependent ℚ g
    exact hg_linearIndependent
  have hker_lower : T.card ≤ Module.finrank ℚ F.ker := by
    simpa only [Fintype.card_coe] using
      hgker_linearIndependent.fintype_card_le_finrank
  have hsum := F.finrank_range_add_finrank_ker
  change Module.finrank ℚ (LinearMap.range F) ≤ Module.finrank ℚ W - T.card
  omega

/-- The finite-support rank cap supplied by the parallel-line ideal.  It is
the exact algebraic form of the manuscript's inequality before one proves
that the relevant weighted support contains the displayed multiples. -/
theorem generalBidegreeCoefficientEvaluationRank_le_card_sub_card
    (A B : ℕ)
    (U T : Finset generalBidegreeCoefficientMonomialIndex)
    (hUT : ∀ m : T,
      generalBidegreeParallelLinePolynomial A *
        MvPolynomial.monomial (m : generalBidegreeCoefficientMonomialIndex) (1 : ℚ) ∈
          generalBidegreeCoefficientMonomialSpan U) :
    generalBidegreeCoefficientEvaluationRank A B U ≤ U.card - T.card := by
  classical
  let hfinite :
      FiniteDimensional ℚ (generalBidegreeCoefficientMonomialSpan U) :=
    FiniteDimensional.span_of_finite ℚ
      (generalBidegreeCoefficientMonomialFinset U).finite_toSet
  have hrank := @finrank_range_generalBidegreeGridPolynomialEvaluation_domRestrict_le
    A B (generalBidegreeCoefficientMonomialSpan U) hfinite T (by
      intro m
      exact hUT m)
  have hdimension : Module.finrank ℚ
      (generalBidegreeCoefficientMonomialSpan U) ≤ U.card := by
    calc
      Module.finrank ℚ (generalBidegreeCoefficientMonomialSpan U) ≤
          (generalBidegreeCoefficientMonomialFinset U).card := by
        unfold generalBidegreeCoefficientMonomialSpan
        exact finrank_span_finset_le_card _
      _ ≤ U.card := by
        unfold generalBidegreeCoefficientMonomialFinset
        exact Finset.card_image_le
  change Module.finrank ℚ (LinearMap.range
    ((generalBidegreeGridPolynomialEvaluationLinearMap A B).domRestrict
      (generalBidegreeCoefficientMonomialSpan U))) ≤ U.card - T.card
  omega

end PellPaper
